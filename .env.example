# Servidor
PORT=3030
# URL pública deste servidor (usada nas imagens do email de certificado)
APP_URL=https://seu-servidor.exemplo.com
# Origens liberadas para o websocket, separadas por vírgula (opcional)
ALLOWED_ORIGINS=

# PocketBase
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Envio de email (Gmail OAuth2)
MAIL_USER=conta@exemplo.com
# Remetente exibido (opcional; padrão = MAIL_USER)
MAIL_FROM=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
# Intervalo mínimo entre envios, em ms (opcional; padrão 2000)
EMAIL_SEND_DELAY_MS=

# Login do painel
# Emails que podem entrar, separados por vírgula
AUTH_ALLOWED_EMAILS=
# Segredo que assina as sessões (string aleatória longa)
AUTH_SECRET=
# Template do email de código (opcional; padrão: o template "Código de acesso",
# criado automaticamente no primeiro uso). Variável do template: {{code}}
AUTH_CODE_TEMPLATE_ID=
